// Konveyor configuration — t14. Linked to ~/.config/konveyor/config.kdl by
// modules/home/plasma.nix (out-of-store), so edits here, or in Konveyor's own
// settings page, are live on save and land in this repo either way.
//
// Started from upstream's data/default-config.kdl (every option, with its
// explanation). Changed from it: the binds block (vim keys), both 4-finger taps
// (Overview instead of the Kontrol Panel widget), and hide-desktop-widgets
// removed — the last two need upstream's widgets, which are not installed.

input {
}

layout {
    fixed-workspace-count 0
    gaps 4
    center-focused-column "never"

    // Where a new window's column opens: "left" or "right" of the focused
    // column. A column pinned with column-position sends it to the other side.
    new-column-position "right"

    // Stretch a column to the full width while it is the only one on its
    // workspace; it goes back to its own width once another column opens.
    // Apps that can't be resized keep their own size.
    always-expand-single-column true

    preset-column-widths {
        proportion 0.25
        proportion 0.5
        proportion 0.75
        proportion 1.0
    }

    default-column-width { proportion 0.5; }
    remember-window-sizes false
    remember-window-positions false

    // When an app already has a window on the workspace, open the new one
    // next to it: "beside" gives it its own column right of the app's
    // columns, "stack" adds it as a row under them, "off" opens it beside
    // the focused column. Window rules can choose per app.
    group-app-windows "beside"
    max-rows-per-column 3

    // "column" gives every new window its own column. "stack" adds it as a
    // row to the focused column until that column holds max-rows-per-column
    // windows, then opens a new column. Monitor profiles and window rules can
    // choose differently.
    new-window-placement "column"

    // Float every window an app opens while it already has one open.
    // Off globally; window rules turn it on per app (Steam below).
    float-child-windows false

    focus-ring {
        width 2
        // "accent" follows the KDE accent color.
        active-color "accent"
        inactive-color "#505050"
    }

    border {
        width 2
        active-color "accent"
        inactive-color "#505050"
        urgent-color "#9b0000"
        off
    }

    struts {
    }
    tab-indicator {
        gaps-between-tabs 6
    }
}

gestures {
    // KDE screen edges already open the overview, so the hot corner is off here.
    hot-corners {
        off
    }

    // "move-window" drags a tiled window by its title bar to a new position in the row, "scroll-view" scrolls the columns instead.
    titlebar-drag "move-window"

    // Dragging a tiled window's edge resizes its column or row. Set it to false
    // to change the layout only through shortcuts and presets. Floating windows
    // can always be resized.
    resize-tiled-windows true

    // Multi-finger touchpad gestures. 3-finger swipes move the row, 4-finger
    // swipes push the focused window into the next column or to another
    // workspace, and a 4-finger pinch opens KDE's Overview. The finger counts
    // used here replace the matching KDE gestures. A quick 3-finger tap cycles
    // the focused column's width like Mod+R and a 4-finger tap opens or closes
    // the Kontrol Panel; while the 3-finger tap is mapped it replaces the
    // touchpad's 3-finger middle click.
    touchpad {
        swipe-fingers 3
        pinch-fingers 4
        natural-swipe
        horizontal-swipe "scroll-view"
        vertical-swipe "switch-workspace"
        pinch "toggle-overview"
        window-swipe-fingers 4
        window-horizontal-swipe "consume-or-expel"
        window-vertical-swipe "move-window"
        // Touchpad TAPS are inert on t14: counting the fingers of a tap needs raw
        // /dev/input access (the `input` group), deliberately not granted — see
        // modules/nixos/plasma.nix. Swipes and pinches above work regardless,
        // and a 3-finger tap stays libinput's middle click. Kept configured so
        // adding the group is the only step if that is ever wanted.
        three-finger-tap "cycle-width"
        four-finger-tap "toggle-overview"   // upstream: "kontrol-panel" (widget, not installed)
        five-finger-tap "off"
    }

    // Touchscreen gestures. One finger still taps, scrolls and drags title bars;
    // holding a title bar before dragging lifts the window to move it. Taps work
    // like the touchpad's but act on the column under your fingers.
    touchscreen {
        swipe-fingers 3
        pinch-fingers 4
        natural-swipe
        horizontal-swipe "scroll-view"
        vertical-swipe "switch-workspace"
        pinch "toggle-overview"
        window-swipe-fingers 4
        window-horizontal-swipe "consume-or-expel"
        window-vertical-swipe "move-window"
        long-press-to-move
        long-press-ms 500
        three-finger-tap "cycle-width"
        four-finger-tap "toggle-overview"   // upstream: "kontrol-panel" (widget, not installed)
        five-finger-tap "off"
    }
}

// Konveyor times its own animations and ignores Plasma's speed setting
// (AnimationDurationFactor 0.5 in modules/home/plasma.nix), so this matches
// it. Its springs otherwise take ~0.4 s to settle, and it steps them on its
// own 8 ms timer by really moving the windows, and on width changes really
// resizing them: half the length is half the redraws an app is asked for.
animations {
    slowdown 0.5
}

// Screens taller than they are wide: every column fills the width and holds
// two windows stacked, so Mod+Left/Right flips between full-width pages and
// Mod+Up/Down moves between the two rows.
monitor-profile "portrait" {
    match aspect-ratio-below=1.0
    layout {
        default-column-width { proportion 1.0; }
        preset-column-widths {
            proportion 0.5
            proportion 1.0
        }
        new-window-placement "stack"
        max-rows-per-column 2
    }
}

monitor-profile "ultrawide" {
    match aspect-ratio-above=2.0
    layout {
        preset-column-widths {
            proportion 0.25
            proportion 0.5
            proportion 0.75
            proportion 1.0
        }
    }
}

// Window rules can target a monitor profile, e.g. a browser that fills a
// normal monitor but takes half of an ultrawide:
// window-rule {
//     match app-id=r#"^google-chrome$"# monitor-profile="ultrawide"
//     default-column-width { proportion 0.5; }
// }

window-rule {
    geometry-corner-radius 6
    clip-to-geometry true
}

// An empty default-column-width lets WezTerm open at the width it asks for.
window-rule {
    match app-id=r#"^org\.wezfurlong\.wezterm$"#
    default-column-width {}
}

// ── floating ──
// Dialogs and any window with a parent (file pickers, "Save as", confirmations)
// float on their own; these are the standalone windows that should too.
// Mod+Space flips any window between floating and tiled; Mod+Shift+Space moves
// focus between the floating layer and the row.

// Picture-in-picture: floats in the bottom-right corner and stays on screen
// across workspace switches. Zen reports itself as "zen-beta", which is why the
// old firefox-only rule never fired here. Chromium-family browsers title it differently.
window-rule {
    match app-id=r#"^(zen|firefox)"# title="^Picture-in-Picture$"
    match title="^Picture in picture$"
    open-floating true
    open-on-all-workspaces true
    default-floating-position x=16 y=16 relative-to="bottom-right"
}

// A browser's "you are sharing your screen" bar. It stays visible on every
// workspace so you can always see that you are still sharing.
window-rule {
    match title=r#"Sharing Indicator$"#
    match title=r#"is sharing (your screen|a window|a tab)"#
    open-floating true
    open-on-all-workspaces true
    default-floating-position x=0 y=8 relative-to="top"
}

// Browser side windows: downloads/history ("Library") and extension popups
// (password managers and the like).
window-rule {
    match app-id=r#"^(zen|firefox)"# title="^Library$"
    match app-id=r#"^(zen|firefox)"# title=r#"^Extension: "#
    open-floating true
}

// KDE's portal: the "choose a screen or window to share" picker, and the file
// chooser when an app asks through the portal rather than its own dialog.
window-rule {
    match app-id=r#"^org\.freedesktop\.impl\.portal\.desktop\.kde$"#
    match app-id=r#"^xdg-desktop-portal-gtk$"#
    open-floating true
}

// Screenshots, passwords and prompts: quick in-and-out windows that would
// otherwise shove the whole row over by a column.
window-rule {
    match app-id=r#"^org\.kde\.spectacle$"#
    match app-id=r#"^org\.kde\.polkit-kde-authentication-agent-1$"#
    match app-id=r#"^org\.kde\.ksshaskpass$"#
    match app-id=r#"pinentry"#
    match app-id=r#"^org\.kde\.(kwalletd6|ksecretd)$"#
    match app-id=r#"^org\.kde\.kdeconnect\.handler$"#
    match app-id=r#"^org\.kde\.bluedevil"#
    match app-id=r#"^org\.pulseaudio\.pavucontrol$"#
    match app-id=r#"^org\.kde\.kcalc$"#
    open-floating true
}

// A floating window opens at the size the app asks for, and Spectacle asks for
// one the size of the screenshot: after a capture its editor filled the
// screen. This opens it as a centred 60% × 75% window instead.
// A full-screen window (the region-select overlay) is sized before any rule.
window-rule {
    match app-id=r#"^org\.kde\.spectacle$"#
    default-column-width { proportion 0.6; }
    default-window-height { proportion 0.75; }
}

// Steam opens its friends list, chats and game properties as separate
// windows. Its main window tiles and the rest float above the row.
window-rule {
    match app-id=r#"^steam$"#
    float-child-windows true
}

window-rule {
    match app-id=r#"^steam$"# title="^Steam$"
    open-floating false
}

window-rule {
    match app-id=r#"^org\.kde\.plasma\.emojier$"#
    open-floating true
}

// `manage false` leaves a window to KWin instead of tiling it. Steam opens its
// menus, notification toasts and loading placeholders as ordinary windows.
window-rule {
    match app-id=r#"^steam$"# title=r#"^(SteamWebhelper|about:blank.*|.+ Menu|.+ Supernav|notificationtoasts_.*|Special Offers)$"#
    manage false
}

binds {
    // The keys every tiling WM shares (Hyprland, i3, sway), with vim hjkl
    // and the arrows as two spellings of the same direction:
    //   Mod + h j k l / arrows          focus
    //   Mod + Shift + h j k l / arrows  move the window
    //   Mod + Ctrl  + h j k l / arrows  resize (width on h/l, height on j/k)
    //   Mod + Alt   + h j k l / arrows  focus another monitor (+Shift: move there)
    //   Mod + 1-9 / Mod + Shift + 1-9   go to / send the window to a workspace
    // Konveyor registers each Shift+digit bind under the symbol KDE records
    // for it too (Meta+!), which is what makes Mod+Shift+1 fire.
    //
    // Desktop keys bound in modules/home/plasma.nix, not here: Mod+Space
    // (search), Mod+Shift+V (clipboard), Mod+; (emoji), Mod+Shift+S
    // (screenshot), Mod+Backspace (lock), Mod+Shift+E (log out / power), and
    // Mod+T (title bars, pkgs/titlebar-toggle). KDE's Mod+W / Mod+G overviews stay.
    //
    // Konveyor takes any KDE shortcut a bind here needs, and gives it back
    // when the bind is removed; `konveyor restore-shortcuts` returns them all.

    Mod+Slash       hotkey-overlay-title="Show Shortcut Cheatsheet" { show-hotkey-overlay; }
    Mod+Shift+Slash { show-hotkey-overlay; }

    // ── apps ──
    // A plain spawn runs the app inside KWin's own systemd service, where it
    // would go down with KWin and be counted as KWin. systemd-run gives each
    // its own scope in app.slice, as Kickoff and KRunner do (~30 ms; kstart,
    // which does the same through KIO, added ~400 ms to Dolphin).
    // Ghostty's `+new-window` asks the running instance over D-Bus without
    // starting GTK first (~120 ms against ~250 ms for `ghostty`), and when no
    // instance runs, D-Bus starts Ghostty as its own user service.
    Mod+Return hotkey-overlay-title="Terminal" { spawn "ghostty" "+new-window"; }
    // Takes Meta+B from KDE's power-profile switcher (the battery icon still has it).
    Mod+B hotkey-overlay-title="Browser" { spawn "systemd-run" "--user" "--scope" "--slice=app.slice" "--quiet" "zen-beta"; }
    Mod+E hotkey-overlay-title="Files" { spawn "systemd-run" "--user" "--scope" "--slice=app.slice" "--quiet" "dolphin"; }
    Mod+Q { close-window; }

    // ── focus ──
    Mod+H     { focus-column-left; }
    Mod+J     { focus-window-or-workspace-down; }
    Mod+K     { focus-window-or-workspace-up; }
    Mod+L     { focus-column-right; }
    Mod+Left  { focus-column-left; }
    Mod+Down  { focus-window-or-workspace-down; }
    Mod+Up    { focus-window-or-workspace-up; }
    Mod+Right { focus-column-right; }
    Mod+Home  { focus-column-first; }
    Mod+End   { focus-column-last; }

    // ── move ──
    Mod+Shift+H     { move-column-left; }
    Mod+Shift+J     { move-window-down-or-to-workspace-down; }
    Mod+Shift+K     { move-window-up-or-to-workspace-up; }
    Mod+Shift+L     { move-column-right; }
    Mod+Shift+Left  { move-column-left; }
    Mod+Shift+Down  { move-window-down-or-to-workspace-down; }
    Mod+Shift+Up    { move-window-up-or-to-workspace-up; }
    Mod+Shift+Right { move-column-right; }
    Mod+Shift+Home  { move-column-to-first; }
    Mod+Shift+End   { move-column-to-last; }

    // ── resize ── (Ctrl+j grows the window downward, Ctrl+k shrinks it)
    Mod+Ctrl+H     { set-column-width "-10%"; }
    Mod+Ctrl+L     { set-column-width "+10%"; }
    Mod+Ctrl+J     { set-window-height "+10%"; }
    Mod+Ctrl+K     { set-window-height "-10%"; }
    Mod+Ctrl+Left  { set-column-width "-10%"; }
    Mod+Ctrl+Right { set-column-width "+10%"; }
    Mod+Ctrl+Down  { set-window-height "+10%"; }
    Mod+Ctrl+Up    { set-window-height "-10%"; }
    Mod+Minus       { set-column-width "-10%"; }
    Mod+Equal       { set-column-width "+10%"; }
    Mod+Shift+Minus { set-window-height "-10%"; }
    Mod+Shift+Equal { set-window-height "+10%"; }
    // Cycle the column through 1/4, 1/2, 3/4 and full width (Shift: backwards).
    Mod+R            { switch-preset-column-width; }
    Mod+Shift+R      { switch-preset-column-width-back; }
    Mod+Ctrl+R       { reset-window-height; }
    Mod+Ctrl+Shift+R { switch-preset-window-height; }

    // ── window state ──
    Mod+F       { fullscreen-window; }
    // Maximize: the column takes the full width, the bar stays visible.
    Mod+M       { maximize-column; }
    Mod+Ctrl+F  { expand-column-to-available-width; }
    Mod+V       { toggle-window-floating; }
    Mod+Shift+Space { switch-focus-between-floating-and-tiling; }
    Mod+C       { center-column; }
    Mod+Ctrl+C  { center-visible-columns; }

    // ── columns ── (scrolling-layout only: no Hyprland equivalent)
    Mod+BracketLeft  { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }
    Mod+Comma  { consume-window-into-column; }
    Mod+Period { expel-window-from-column; }
    // Shows a stacked column's windows as tabs, one at a time; press again to undo.
    Mod+Shift+W { toggle-column-tabbed-display; }

    // ── workspaces ──
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }
    Mod+Shift+5 { move-column-to-workspace 5; }
    Mod+Shift+6 { move-column-to-workspace 6; }
    Mod+Shift+7 { move-column-to-workspace 7; }
    Mod+Shift+8 { move-column-to-workspace 8; }
    Mod+Shift+9 { move-column-to-workspace 9; }
    // Back and forth between the last two workspaces. Alt+Tab still switches windows.
    Mod+Tab { focus-workspace-previous; }
    // Workspaces are a vertical stack: u/i and PgDn/PgUp step down/up through
    // it. Shift takes the column along; Ctrl moves the whole workspace.
    Mod+U         { focus-workspace-down; }
    Mod+I         { focus-workspace-up; }
    Mod+Page_Down { focus-workspace-down; }
    Mod+Page_Up   { focus-workspace-up; }
    Mod+Shift+U         { move-column-to-workspace-down; }
    Mod+Shift+I         { move-column-to-workspace-up; }
    Mod+Shift+Page_Down { move-column-to-workspace-down; }
    Mod+Shift+Page_Up   { move-column-to-workspace-up; }
    Mod+Ctrl+U         { move-workspace-down; }
    Mod+Ctrl+I         { move-workspace-up; }
    Mod+Ctrl+Page_Down { move-workspace-down; }
    Mod+Ctrl+Page_Up   { move-workspace-up; }

    // ── monitors ── (only matters docked)
    Mod+Alt+H     { focus-monitor-left; }
    Mod+Alt+J     { focus-monitor-down; }
    Mod+Alt+K     { focus-monitor-up; }
    Mod+Alt+L     { focus-monitor-right; }
    Mod+Alt+Left  { focus-monitor-left; }
    Mod+Alt+Down  { focus-monitor-down; }
    Mod+Alt+Up    { focus-monitor-up; }
    Mod+Alt+Right { focus-monitor-right; }
    Mod+Alt+Shift+H     { move-column-to-monitor-left; }
    Mod+Alt+Shift+J     { move-column-to-monitor-down; }
    Mod+Alt+Shift+K     { move-column-to-monitor-up; }
    Mod+Alt+Shift+L     { move-column-to-monitor-right; }
    Mod+Alt+Shift+Left  { move-column-to-monitor-left; }
    Mod+Alt+Shift+Down  { move-column-to-monitor-down; }
    Mod+Alt+Shift+Up    { move-column-to-monitor-up; }
    Mod+Alt+Shift+Right { move-column-to-monitor-right; }

    // ── mouse ── (unchanged from upstream) KWin's own wheel shortcuts come
    // first: Mod+Ctrl with the vertical wheel zooms and Mod+Alt with it
    // switches desktops, so those stay unbound here.
    Mod+WheelScrollDown           cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp             cooldown-ms=150 { focus-workspace-up; }
    Mod+Ctrl+Alt+WheelScrollDown  cooldown-ms=150 { move-column-to-workspace-down; }
    Mod+Ctrl+Alt+WheelScrollUp    cooldown-ms=150 { move-column-to-workspace-up; }
    Mod+WheelScrollRight      { focus-column-right; }
    Mod+WheelScrollLeft       { focus-column-left; }
    Mod+Ctrl+WheelScrollRight { move-column-right; }
    Mod+Ctrl+WheelScrollLeft  { move-column-left; }
    Mod+Shift+WheelScrollDown      { focus-column-right; }
    Mod+Shift+WheelScrollUp        { focus-column-left; }
    Mod+Ctrl+Shift+WheelScrollDown { move-column-right; }
    Mod+Ctrl+Shift+WheelScrollUp   { move-column-left; }
}

// Konveyor extension: stretch Plasma panels to the full screen width while a
// window on that monitor is maximized to the edges, and put them back after.
// The panel's previous width mode is kept in the panel's own settings, so a
// panel you change in the meantime is left the way you set it.
fill-panels-on-maximize

// Konveyor extension: uncomment to stop windows from being minimized. This
// adds a KWin window rule that forces minimize off, which also hides the
// minimize button on KDE title bars. The rule is removed when Konveyor is disabled.
// disable-minimize




hide-desktop-widgets

